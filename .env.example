# Copy this file to `.env` (in this folder or in api/) and fill in the values.
# Never commit your real .env: it's already in .gitignore.

# --- Required -------------------------------------------------------------
# MongoDB connection string (MongoDB Atlas or local, e.g. mongodb://127.0.0.1:27017/blog)
MONGODB_URI=
# Long random string used to sign login tokens. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# --- Optional (defaults shown) --------------------------------------------
# PORT=4000
# Where the React app runs; only this origin may call the API with cookies.
# FRONTEND_URL=http://localhost:3000

# --- Production only ------------------------------------------------------
# NODE_ENV=production      # makes the login cookie HTTPS-only
# COOKIE_SAMESITE=none     # only if frontend and API are on different domains
# TRUST_PROXY=1            # behind Render/Heroku/Nginx, so rate limits see real IPs
# AUTH_RATE_LIMIT=10       # failed login/register attempts per IP per 15 min
# UPLOAD_DIR=api/uploads   # where cover images are stored
